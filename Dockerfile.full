# pibox:latest-full. Pi Coding Agent on the shared full aicodebox base.
#
# Generic development tooling belongs to aicodebox. This image adds only Pi,
# the pibox adapter, and pibox startup behavior.
ARG BASE_IMAGE=psyb0t/aicodebox:v0.18.4-full@sha256:dcacf5779530eaf346979e50cb134ab5f6be56bba1654cc334f158f37b7d884d
FROM ${BASE_IMAGE}

LABEL io.modelcontextprotocol.server.name="io.github.psyb0t/pibox"

USER root

ARG PI_VERSION=1.5.2
RUN npm install -g --ignore-scripts --no-audit --no-fund \
    @earendil-works/pi-coding-agent@${PI_VERSION}

COPY pibox /opt/pibox
RUN uv pip install --system --break-system-packages --no-deps /opt/pibox \
    && chmod +x /opt/pibox/scripts/*.sh

RUN cd /opt/pibox/extensions/mcp-bridge \
    && npm install --omit=dev --ignore-scripts --no-audit --no-fund

# Pi's subagent example, patched to read pibox limits, plus a stable path to
# Pi's model catalog for setup-provider-env.sh. Both fail the build if the
# installed Pi no longer ships them where expected.
RUN pi_root="$(npm root -g)/@earendil-works/pi-coding-agent" \
    && /opt/pibox/scripts/install-subagent-extension.sh \
        "$pi_root/examples/extensions/subagent" /opt/pibox/extensions/subagent \
    && catalog="$(find "$pi_root" -path '*/@earendil-works/pi-ai/dist/providers/data' -type d -print -quit)" \
    && test -n "$catalog" \
    && ln -s "$catalog" /opt/pibox/pi-model-catalog \
    && ls /opt/pibox/pi-model-catalog/*.json >/dev/null

COPY pibox/init.d/ /aicodebox-init.d/
RUN chmod +x /aicodebox-init.d/*.sh

ENV AICODEBOX_ADAPTER=pibox.adapter:PiAdapter \
    AICODEBOX_AGENT_BINARY=pi \
    PIBOX_IMAGE_VARIANT=full

COPY pibox-entrypoint.sh /usr/local/bin/pibox-entrypoint
RUN chmod +x /usr/local/bin/pibox-entrypoint
ENTRYPOINT ["/usr/local/bin/pibox-entrypoint"]
