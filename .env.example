# Direct-container settings for docker run --env-file.
# For wrapper server launches, forward these through PIBOX_ENV_*.
ANTHROPIC_API_KEY=
PIBOX_WORKSPACE=/workspace
PIBOX_CONTAINER_NAME=pibox
PIBOX_GIT_NAME=
PIBOX_GIT_EMAIL=
# Optional shared identity values override nonempty child aliases.
AICODEBOX_GIT_NAME=
AICODEBOX_GIT_EMAIL=

PIBOX_API_MODE=0
PIBOX_API_MODE_PORT=8080
PIBOX_API_MODE_TOKEN=
# Set the model IDs supported by your configured provider before API mode.
PIBOX_AVAILABLE_MODELS=
PIBOX_AVAILABLE_EFFORTS=
PIBOX_TELEGRAM_MODE=0
PIBOX_TELEGRAM_MODE_TOKEN=
PIBOX_TELEGRAM_MODE_CONFIG=
PIBOX_TELEGRAM_MODE_OVERRIDES=
PIBOX_CRON_MODE=0
PIBOX_CRON_MODE_FILE=
PIBOX_CRON_MODE_HISTORY_DIR=
PIBOX_MCP_MODE=0
PIBOX_MCP_MODE_PORT=8081
PIBOX_MCP_MODE_TOKEN=
PIBOX_MCP_MODE_ALLOWED_HOSTS=
PIBOX_MCP_MODE_ALLOWED_ORIGINS=
DEBUG=false
