# Copy to .env.test and fill in real values. .env.test is gitignored.
# The legacy compatibility tests use the Anthropic-compatible Z.AI endpoint.
ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic
ANTHROPIC_AUTH_TOKEN=your-z-ai-api-key
ANTHROPIC_MODEL=glm-4.6

# Generic-provider tests use both Z.AI Coding Plan protocols. Leave the token
# blank to reuse ANTHROPIC_AUTH_TOKEN. Set a different token when needed.
ZAI_CODING_AUTH_TOKEN=
ZAI_CODING_ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic
ZAI_CODING_OPENAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
ZAI_CODING_MODEL=glm-5.3-flash
