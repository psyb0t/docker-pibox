# Copy this to .env.test and fill in real values. .env* is gitignored.
#
# Z.AI exposes an Anthropic-compatible endpoint — any harness that speaks
# Anthropic (claude-code, pi, opencode, hermes) can hit it with the same token.
ANTHROPIC_AUTH_TOKEN=your-token-here
ANTHROPIC_BASE_URL=https://api.z.ai/api/anthropic
ANTHROPIC_MODEL=glm-4.6

# pi reads ANTHROPIC_API_KEY too (same value as the auth token for Z.AI).
ANTHROPIC_API_KEY=your-token-here

# Telegram e2e tests (test_telegram.sh, test_cron_telegram.sh, test_e2e_telegram.sh).
# Leave blank to skip those tests.
AICODEBOX_TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Telethon userbot — drives the user side of the Telegram e2e tests.
# Get API_ID / API_HASH from https://my.telegram.org/apps.
# Get TELETHON_SESSION from psyb0t/docker-telethon (make login).
TELETHON_API_ID=
TELETHON_API_HASH=
TELETHON_SESSION=
TELETHON_AUTH_KEY=
